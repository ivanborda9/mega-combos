# Base de datos Postgres. En Vercel: Storage → Create Database → Neon, y conectala
# al proyecto (carga DATABASE_URL sola).
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# Usuario y contraseña para entrar al admin (/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"

# Segundo admin opcional, con el mismo acceso completo que el primero
# (otra persona entra con sus propios datos). Si se dejan vacías, no existe.
ADMIN2_USERNAME=""
ADMIN2_PASSWORD=""

# Sub-admin opcional para despacho: entra con este usuario y solo ve los pedidos
# (datos del comprador) y puede marcarlos como despachados. Si se dejan vacías, no existe.
EMPLOYEE_USERNAME=""
EMPLOYEE_PASSWORD=""

# Clave para firmar la sesión del admin: una cadena larga y al azar
ADMIN_SESSION_SECRET="cambiar-por-una-cadena-secreta-larga"

# El WhatsApp de la tienda (2281 583030) está fijo en src/lib/config.ts.

# Nombre de la tienda que aparece en el sitio
NEXT_PUBLIC_STORE_NAME="REINAS XL"

# Descuento (%) por pagar con transferencia o depósito. 0 para no ofrecerlo. Por defecto 15.
NEXT_PUBLIC_TRANSFER_DISCOUNT="15"

# Texto de la franja de avisos que corre arriba de la tienda (opcional)
NEXT_PUBLIC_ANNOUNCEMENT="🔥 3 CUOTAS SIN INTERÉS 🔥 + ENTREGA RÁPIDA A TODO EL PAÍS"

# Cartel de compra rápida con cuenta regresiva (opcional). Minutos de la cuenta; 0 lo desactiva.
NEXT_PUBLIC_PROMO_TITLE="ÚLTIMA SEMANA EN STOCK 🔥"
NEXT_PUBLIC_PROMO_SUBTITLE="IMPERDIBLE!!"
NEXT_PUBLIC_PROMO_MINUTES="15"

# Mercado Pago (Checkout Pro). Con el Access Token de PRODUCCIÓN de tu cuenta
# (Mercado Pago Developers → Tus integraciones → Credenciales de producción).
# Si está vacío, el carrito ofrece "Mercado Pago / Tarjeta / Otro" coordinado por WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=""
# Cuotas máximas que se ofrecen (por defecto 3)
MERCADOPAGO_INSTALLMENTS="3"
# "false" si las cuotas NO son sin interés (las cuotas sin interés se activan en tu cuenta de Mercado Pago)
MERCADOPAGO_SIN_INTERES="true"
# Opcional: clave secreta de las notificaciones (webhooks) para validar la firma
MERCADOPAGO_WEBHOOK_SECRET=""

# Datos para transferir que se muestran al comprar con transferencia
NEXT_PUBLIC_TRANSFER_ALIAS="REINASXL.WEB"
NEXT_PUBLIC_TRANSFER_HOLDER="Maria Laura Etchevers"

# Retiro en local (opcional): dirección y horarios que se muestran al elegir "Retiro en local".
# Si están vacíos, se avisa que la dirección se pasa por WhatsApp.
NEXT_PUBLIC_PICKUP_ADDRESS=""
NEXT_PUBLIC_PICKUP_HOURS=""
